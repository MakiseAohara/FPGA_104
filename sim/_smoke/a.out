#! D:/iverilog\Library/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "D:\iverilog\Library\lib\ivl\system.vpi";
:vpi_module "D:\iverilog\Library\lib\ivl\vhdl_sys.vpi";
:vpi_module "D:\iverilog\Library\lib\ivl\vhdl_textio.vpi";
:vpi_module "D:\iverilog\Library\lib\ivl\v2005_math.vpi";
:vpi_module "D:\iverilog\Library\lib\ivl\va_math.vpi";
:vpi_module "D:\iverilog\Library\lib\ivl\v2009.vpi";
S_00000000034a6330 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_00000000035cdfa0 .scope module, "tb" "tb" 3 2;
 .timescale -9 -12;
v00000000034a64c0_0 .var "clk", 0 0;
v00000000034a6560_0 .var/i "errs", 31 0;
v00000000035ce2c0_0 .net "q", 3 0, v00000000034a7b70_0;  1 drivers
v00000000035ce360_0 .var "rst_n", 0 0;
E_00000000035cb780 .event posedge, v00000000034a61d0_0;
S_00000000035ce130 .scope module, "u" "counter" 3 4, 4 2 0, S_00000000035cdfa0;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst_n";
    .port_info 2 /OUTPUT 4 "q";
v00000000034a61d0_0 .net "clk", 0 0, v00000000034a64c0_0;  1 drivers
v00000000034a7b70_0 .var "q", 3 0;
v00000000035c6ec0_0 .net "rst_n", 0 0, v00000000035ce360_0;  1 drivers
E_00000000035cbe80/0 .event negedge, v00000000035c6ec0_0;
E_00000000035cbe80/1 .event posedge, v00000000034a61d0_0;
E_00000000035cbe80 .event/or E_00000000035cbe80/0, E_00000000035cbe80/1;
    .scope S_00000000035ce130;
T_0 ;
    %wait E_00000000035cbe80;
    %load/vec4 v00000000035c6ec0_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v00000000034a7b70_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v00000000034a7b70_0;
    %addi 1, 0, 4;
    %assign/vec4 v00000000034a7b70_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_00000000035cdfa0;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v00000000034a64c0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v00000000035ce360_0, 0, 1;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v00000000034a6560_0, 0, 32;
    %end;
    .thread T_1, $init;
    .scope S_00000000035cdfa0;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v00000000034a64c0_0;
    %inv;
    %store/vec4 v00000000034a64c0_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_00000000035cdfa0;
T_3 ;
    %delay 12000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v00000000035ce360_0, 0, 1;
    %wait E_00000000035cb780;
    %pushi/vec4 5, 0, 32;
T_3.0 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_3.1, 5;
    %jmp/1 T_3.1, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %wait E_00000000035cb780;
    %delay 1000, 0;
    %vpi_call/w 3 11 "$display", "q=%0d", v00000000035ce2c0_0 {0 0 0};
    %jmp T_3.0;
T_3.1 ;
    %pop/vec4 1;
    %load/vec4 v00000000035ce2c0_0;
    %cmpi/ne 5, 0, 4;
    %jmp/0xz  T_3.2, 6;
    %vpi_call/w 3 13 "$display", "FAIL: expect 5 got %0d", v00000000035ce2c0_0 {0 0 0};
    %load/vec4 v00000000034a6560_0;
    %addi 1, 0, 32;
    %store/vec4 v00000000034a6560_0, 0, 32;
    %jmp T_3.3;
T_3.2 ;
    %vpi_call/w 3 14 "$display", "PASS: counter counted to 5" {0 0 0};
T_3.3 ;
    %load/vec4 v00000000034a6560_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_3.4, 4;
    %vpi_call/w 3 15 "$display", "=== ALL TESTS PASSED ===" {0 0 0};
    %jmp T_3.5;
T_3.4 ;
    %vpi_call/w 3 15 "$display", "=== %0d FAILURES ===", v00000000034a6560_0 {0 0 0};
T_3.5 ;
    %vpi_call/w 3 16 "$finish" {0 0 0};
    %end;
    .thread T_3;
