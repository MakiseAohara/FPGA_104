 // channels 包装只输出 1 位 lock（[0:0]），互联每口要 2 位 —— 高位显式补 0，
 // 否则 tml_awlock[1]/tml_arlock[1] 悬空(z) 还会被拼进互联输入
+`ifdef MMT_TINYML_ENABLE
 assign tml_awlock[1] = 1'b0;
