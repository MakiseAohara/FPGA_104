      "hint": "人退出画面，保持空场"
    },
    {
      "name": "正脸走动",
      "seconds": 120,
      "hint": "正脸对镜头来回走动，1.5~2 m"
    },
    {
      "name": "侧身看手机",
      "seconds": 60,
      "hint": "侧身站着看手机，上半身保持在画面里"
    },
    {
      "name": "站定不动 1",
      "seconds": 30,
      "hint": "站定不动"
    },
    {
      "name": "离开",
      "seconds": 30,
      "hint": "退出画面"
    },
    {
      "name": "站定不动 2",
      "seconds": 30,
      "hint": "回到原位站定不动"
    },
    {
      "name": "离开",
      "seconds": 30,
      "hint": "退出画面"
    },
    {
      "name": "站定不动 3",
      "seconds": 30,
      "hint": "回到原位站定不动"
    },
    {
      "name": "进出交替",
      "seconds": 180,
      "hint": "反复进出画面，每次停留 5~10 秒"
    },
    {
      "name": "空场",
      "seconds": 120,
      "hint": "退出画面，保持空场"
    },
    {
      "name": "走动",
      "seconds": 180,
      "hint": "在画面里自由走动"
    },
    {
      "name": "空场",
      "seconds": 180,
      "hint": "退出画面，保持空场"
    },
    {
      "name": "进出交替",
      "seconds": 120,
      "hint": "最后一段：反复进出画面"
    }
  ]
