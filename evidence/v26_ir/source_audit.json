  "sources": {
    "rtl/v7/mmt/v7_mmt_core.v": {
      "bytes": 17370,
      "sha256": "8ceb00a56483439419c320152b393e9b8c1d2152cb5b158a3dc8ebd70a492b22",
      "excerpts": [
        {
          "start": 99,
          "end": 106,
          "lines": [
            "99:     wire sht_valid, sht_crc_err, sht_bus_err, ir_fv, ir_bus_err;",
            "100:     wire signed [15:0] sht_t; wire [15:0] sht_rh; wire [9:0] ir_ra; wire [15:0] ir_rd;",
            "101:     mmt_sensor_subsystem #(.CLK_HZ(CLK_HZ), .SCL_HZ(SCL_HZ), .SHT30_PERIOD_MS(SHT_PERIOD_MS), .IR_PERIOD_MS(IR_PERIOD_MS), .MLX_REFRESH_CODE(IR_REFRESH_CODE)) u_sns (",
            "102:         .clk(clk), .rst_n(rst_n), .scl_i(scl_i), .scl_o(scl_o_w), .scl_oe(scl_oe_w), .sda_i(sda_i), .sda_o(sda_o_w), .sda_oe(sda_oe_w),",
            "103:         .sht_data_valid(sht_valid), .sht_temp_c_x100(sht_t), .sht_rh_x100(sht_rh), .sht_temp_raw(), .sht_rh_raw(),",
            "104:         .sht_crc_err(sht_crc_err), .sht_bus_err(sht_bus_err),",
            "105:         .ir_frame_cnt(), .ir_frame_valid(ir_fv), .ir_ta_raw(), .ir_bus_err(ir_bus_err),",
            "106:         .ir_rd_addr(ir_ra), .ir_rd_data(ir_rd), .i2c_busy(), .i2c_owner());"
          ]
        },
        {
          "start": 119,
          "end": 140,
          "lines": [
            "119:     wire [15:0] hot_delta; wire ir_valid;",
            "120:     v7_ir_proc u_ir (.clk(clk), .rst_n(rst_n), .frame_valid(ir_fv), .learn_req(learn_btn),",
            "121:         .rd_addr(ir_ra), .rd_data(ir_rd), .heat_we(th_we), .heat_wa(th_wa), .heat_wd(th_wd),",
            "122:         .hot_delta(hot_delta), .valid(ir_valid));",
            "123:     // 温度换算：每一级都打拍（148.5MHz 下 DSP 乘法 + 长加法不能挤在一拍里）",
            "124:     reg  [15:0] t_pos;       always @(posedge clk) t_pos <= sht_t_f[15] ? 16'd0 : sht_t_f;",
            "125:     reg  [31:0] amb_m;       always @(posedge clk) amb_m <= t_pos * 32'd13107;   // ×0.1 ≈ ×13107/2^17",
            "126:     reg  [15:0] amb_x10;     always @(posedge clk) amb_x10 <= amb_m[31:17];",
            "127:     reg  [31:0] dl;          always @(posedge clk) dl <= hot_delta * IR_K;",
            "128:     reg  [15:0] dl_x10;      always @(posedge clk) dl_x10 <= dl[15+IR_SH:IR_SH];",
            "129:     reg  [15:0] body_raw;    always @(posedge clk) body_raw <= amb_x10 + dl_x10;",
            "130:     reg  signed [15:0] body_x10;",
            "131:     always @(posedge clk) body_x10 <= (body_raw > 16'd450) ? 16'sd450 : $signed(body_raw);",
            "132: ",
            "133:     //---------------- 融合决策 ----------------",
            "134:     wire [7:0] cv, ct, ce; wire [8:0] score; wire in_win, alarm_raw;",
            "135:     mmt_fusion_vote u_fv (.clk(clk), .rst_n(rst_n), .vision_prob(vision_prob), .vision_valid(vis_valid),",
            "136:         .body_max_c_x10(body_x10), .ir_valid(ir_valid & al_ir & IR_IN_FUSION), .ambient_c_x10($signed(amb_x10)), .rh_x100(sht_rh_f),",
            "137:         .env_valid(sht_seen & sht_t_ok & al_sht), .hour(hour), .score_thresh(8'd154), .auth_start_h(5'd22), .auth_end_h(5'd6),",
            "138:         .conf_vision(cv), .conf_temp(ct), .conf_env(ce), .score(score), .in_auth_window(in_win), .alarm(alarm_raw), .alarm_valid());",
            "139:     // 人体证据门控：运动 + 红外热点（热点在上一拍已寄存，hot_delta 来自 ir_proc 的输出寄存器）",
            "140:     reg ir_hot; always @(posedge clk) ir_hot <= ir_valid && (hot_delta >= HOT_ON);"
          ]
        },
        {
          "start": 174,
          "end": 202,
          "lines": [
            "174:     //---------------- I2C 诊断（SENSE6）----------------",
            "175:     reg [1:0] dg_scl_s, dg_sda_s; always @(posedge clk) begin dg_scl_s <= {dg_scl_s[0], scl_i}; dg_sda_s <= {dg_sda_s[0], sda_i}; end",
            "176:     reg [8:0] dg_rel_sda, dg_rel_scl;     // 主机释放线后的稳定计数（>=256 拍 ≈1.7us，远大于上拉上升时间）",
            "177:     reg scl_oe_d, dg_slv_q, dg_slv, dg_stuck, dg_crc, dg_irseen;",
            "178:     reg [15:0] dg_oe_cnt, dg_slv_cnt;",
            "179:     wire dg_slv_now = dg_rel_sda[8] & ~dg_sda_s[1];       // 主机已释放 SDA 却为低 = 从机在拉低（ACK/数据）",
            "180:     wire dg_stk_now = dg_rel_scl[8] & ~dg_scl_s[1];       // 主机已释放 SCL 却为低 = 被外部拉住",
            "181:     always @(posedge clk or negedge rst_n) begin",
            "182:         if (!rst_n) begin dg_rel_sda<=0; dg_rel_scl<=0; scl_oe_d<=0; dg_slv_q<=0; dg_slv<=0; dg_stuck<=0; dg_crc<=0; dg_irseen<=0; dg_oe_cnt<=0; dg_slv_cnt<=0; end",
            "183:         else begin",
            "184:             scl_oe_d <= scl_oe; dg_slv_q <= dg_slv_now;",
            "185:             dg_rel_sda <= sda_oe ? 9'd0 : (dg_rel_sda[8] ? dg_rel_sda : dg_rel_sda + 1'b1);",
            "186:             dg_rel_scl <= scl_oe ? 9'd0 : (dg_rel_scl[8] ? dg_rel_scl : dg_rel_scl + 1'b1);",
            "187:             if (scl_oe & ~scl_oe_d & ~&dg_oe_cnt) dg_oe_cnt <= dg_oe_cnt + 1'b1;",
            "188:             if (dg_slv_now & ~dg_slv_q & ~&dg_slv_cnt) dg_slv_cnt <= dg_slv_cnt + 1'b1;",
            "189:             if (dg_slv_now) dg_slv <= 1'b1;",
            "190:             if (dg_stk_now) dg_stuck <= 1'b1;",
            "191:             if (sht_crc_err) dg_crc <= 1'b1;",
            "192:             if (ir_fv) dg_irseen <= 1'b1;",
            "193:         end",
            "194:     end",
            "195: ",
            "196:     //---------------- I2C 地址扫描（SENSE7）：按住 KEY2 接管总线 ----------------",
            "197:     wire probe_own = ~kl_q;",
            "198:     wire pr_scl_o, pr_scl_oe, pr_sda_o, pr_sda_oe, pr_act; wire [7:0] pr_cnt, pr_scans; wire [6:0] pr_a0, pr_a1;",
            "199:     v7_i2c_probe #(.CLK_HZ(CLK_HZ), .SCL_HZ(PROBE_SCL_HZ)) u_probe (.clk(clk), .rst_n(rst_n), .en(probe_own),",
            "200:         .scl_i(scl_i), .sda_i(sda_i), .scl_o(pr_scl_o), .scl_oe(pr_scl_oe), .sda_o(pr_sda_o), .sda_oe(pr_sda_oe), .active(pr_act),",
            "201:         .res_cnt(pr_cnt), .res_a0(pr_a0), .res_a1(pr_a1), .scans(pr_scans));",
            "202:     assign scl_o  = probe_own ? pr_scl_o  : scl_o_w;"
          ]
        },
        {
          "start": 219,
          "end": 241,
          "lines": [
            "219:     reg  [15:0] conf_x100; always @(posedge clk) conf_x100 <= (score * 9'd25) >> 6;   // score/256*100",
            "220:     wire sns_ok = sht_seen & ~sht_bus_err & ~ir_bus_err;",
            "221:     wire [15:0] ir_x10 = body_raw;",
            "222:     v7_txt_fmt u_fmt (.clk(clk), .rst_n(rst_n), .refresh(vs_rise),",
            "223:         .temp_x100(t_pos), .rh_x100(sht_rh_f), .ir_x10(ir_x10), .area(fd_area), .conf_x100(conf_x100),",
            "224:         .ai_score(ai_score), .ai_alive(ai_alive), .ai_person(ai_p_eff), .motion(fd_motion), .alarm_on(alarm_final), .evt_code(fw_evt), .night(night), .sns_ok(sns_ok), .low_pwr(low_pwr),",
            "225:         .dg_lb_scl(dg_lb_scl), .dg_lb_sda(dg_lb_sda), .pr_scans(pr_scans), .pr_cnt(pr_cnt), .pr_a0(pr_a0), .pr_a1(pr_a1), .dg_scl(dg_scl_s[1]), .dg_sda(dg_sda_s[1]), .dg_slv(dg_slv), .dg_stuck(dg_stuck), .dg_sht_err(sht_bus_err), .dg_ir_err(ir_bus_err),",
            "226:         .dg_sht_seen(sht_seen), .dg_irseen(dg_irseen), .dg_crc(dg_crc), .dg_oe_cnt(dg_oe_cnt), .dg_slv_cnt(dg_slv_cnt),",
            "227:         .txt_we(txt_we), .txt_wa(txt_wa), .txt_wd(txt_wd));",
            "228: ",
            "229:     //---------------- MERGE11: 证据快照（APB 字 11/12/13，供 RISC-V 做历史决策） ----------------",
            "230:     // 全部在本时钟域；顶层 v7_apb_ext 在 vs 上升沿锁存后跨到 core_clk 域。",
            "231:     reg [7:0] vs_cnt;                               // 视频帧计数（帧率测量用，8 位回绕）",
            "232:     always @(posedge clk or negedge rst_n) begin",
            "233:         if (!rst_n) vs_cnt <= 8'd0;",
            "234:         else if (vs_rise) vs_cnt <= vs_cnt + 8'd1;",
            "235:     end",
            "236: ",
            "237:     // 字 11：motion / IR 摘要",
            "238:     wire [11:0] body_x10_u = body_x10[15] ? 12'd0 : body_x10[11:0];  // 已钳位 0..450",
            "239:     wire [3:0]  evt_flags  = {sht_seen, ir_valid, ir_hot, fd_motion};",
            "240:     assign obs_evt = {fd_area, body_x10_u, evt_flags};",
            "241:     //   [31:16]=帧差面积  [15:4]=最高体温×10  [3]=sht_seen [2]=ir_valid [1]=ir_hot [0]=motion"
          ]
        }
      ]
    },
    "rtl/v7/mmt/v7_ir_proc.v": {
      "bytes": 4173,
      "sha256": "48f8f98218139e5e89df8a4cb6da6c2825bf7e4e0d2f62e8c978137945ea6486",
      "excerpts": [
        {
          "start": 34,
          "end": 49,
          "lines": [
            "34:     wire signed [16:0] raw = {rd_data[15], rd_data};",
            "35:     wire signed [16:0] base = {base_q[15], base_q};",
            "36:     wire signed [16:0] d = raw - base;",
            "37:     wire [15:0] d_pos = d[16] ? 16'd0 : d[15:0];",
            "38:     // MERGE12/MERGE9: 有符号对称舍入（原先负数直接 >>>3 是向下取整，基线会永远追不上）",
            "39:     wire signed [17:0] d_ext = d;",
            "40:     wire signed [17:0] bstep18 = (d > 0) ? ((d_ext + 18'sd7) >>> 3)",
            "41:                                        : -(((-d_ext) + 18'sd7) >>> 3);",
            "42:     wire signed [16:0] bstep = bstep18[16:0];",
            "43:     wire [15:0] hs = d_pos >> IR_HS;",
            "44:     always @(posedge clk or negedge rst_n) begin",
            "45:         if (!rst_n) begin",
            "46:             st<=S_IDLE; i<=0; rd_addr<=0; learn_pend<=1; learn_cur<=0; freeze_prev<=0; pend_frame<=0;",
            "47:             maxd<=0; base_we<=0; base_wd<=0; base_wa<=0; heat_we<=0; heat_wa<=0; heat_wd<=0;",
            "48:             hot_delta<=0; valid<=0;",
            "49:         end else begin"
          ]
        },
        {
          "start": 51,
          "end": 75,
          "lines": [
            "51:             if (learn_req) learn_pend <= 1'b1;",
            "52:             if (frame_valid) pend_frame <= 1'b1;",
            "53:             case (st)",
            "54:               S_IDLE: if (pend_frame) begin",
            "55:                     pend_frame<=0; i<=0; maxd<=0; learn_cur<=learn_pend; learn_pend<=0; st<=S_ADDR; end",
            "56:               S_ADDR: begin rd_addr<=i; st<=S_W1; end",
            "57:               S_W1:   st<=S_W2;",
            "58:               S_W2:   st<=S_USE;",
            "59:               S_USE: begin",
            "60:                   base_wa<=i; heat_wa<=i; heat_we<=1'b1;",
            "61:                   if (learn_cur) begin",
            "62:                       base_we<=1'b1; base_wd<=rd_data; heat_wd<=8'd0;",
            "63:                   end else begin",
            "64:                       if (!freeze_prev) begin base_we<=1'b1; base_wd<=base_q + bstep[15:0]; end",
            "65:                       heat_wd <= (d_pos <= NOISE) ? 8'd0 : ((hs > 16'd255) ? 8'd255 : (hs[7:0] == 0 ? 8'd1 : hs[7:0]));",
            "66:                       if (d_pos > maxd) maxd <= d_pos;",
            "67:                   end",
            "68:                   if (i == 10'd767) begin",
            "69:                       st<=S_IDLE;",
            "70:                       if (!learn_cur) begin",
            "71:                           hot_delta <= (d_pos > maxd) ? d_pos : maxd;",
            "72:                           freeze_prev <= (((d_pos > maxd) ? d_pos : maxd) > FREEZE_TH);",
            "73:                       end",
            "74:                       valid <= 1'b1; learn_cur <= 1'b0;",
            "75:                   end else begin i<=i+10'd1; st<=S_ADDR; end"
          ]
        }
      ]
    },
