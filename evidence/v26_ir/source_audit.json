    "rtl/ti60f225_oob_top.v": {
      "bytes": 59629,
      "sha256": "f95faf2321c8d23cd0a8d5242a384fbcb55a257aaf291d0adff210dad327b4a9",
      "excerpts": [
        {
          "start": 852,
          "end": 858,
          "lines": [
            "852: // MERGE10: APB -> camera SCCB (16-bit register address, 8-bit data)",
            "853: //   word16 (0x40) write I2C_CMD   : [31]=start [30]=rw [23:8]=reg addr [7:0]=wdata",
            "854: //   word17 (0x44) read  I2C_STATUS: bit0=busy bit1=done(clear on read) bit2=ready",
            "855: //   word18 (0x48) read  I2C_RDATA : [7:0]=last read data",
            "856: // APB domain core_clk, I2C domain CLK_5M: command via toggle+2FF, status via 2FF.",
            "857: // ========================================================================",
            "858: wire        i2c_busy_5m, i2c_done_toggle_5m, i2c_ready_5m;"
          ]
        },
        {
          "start": 920,
          "end": 940,
          "lines": [
            "920: always @* begin",
            "921:   case(soc_apb_paddr[6:2])",
